def main() -> None:
    """Start stdio only when explicitly launched by an MCP client."""
    try:
        create_server().run()
    except RuntimeError as exc:
        print(str(exc), file=sys.stderr)
        raise SystemExit(1) from None


if __name__ == "__main__":
    main()
