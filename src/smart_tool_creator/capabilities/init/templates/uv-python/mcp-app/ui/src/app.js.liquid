import {App} from '@modelcontextprotocol/ext-apps';

const app = new App({name:'{{ title }} manifest', version:'{{ version }}'}, {});
const status = document.querySelector('#status');
const details = document.querySelector('#details');
const refresh = document.querySelector('#refresh');

async function show(result) {
  if (result.isError) throw new Error(result.content?.filter(item => item.type === 'text').map(item => item.text).join('\n') || 'The tool could not read its manifest.');
  const manifest = result.structuredContent;
  if (!manifest?.name) throw new Error('The tool returned no structured manifest.');
  details.textContent = JSON.stringify(manifest, null, 2);
  status.textContent = `${manifest.name} ${manifest.version}`;
  if (app.getHostCapabilities()?.updateModelContext?.structuredContent) {
    await app.updateModelContext({structuredContent:{displayedTool:manifest.name, displayedVersion:manifest.version}});
  }
}

async function reload() {
  refresh.disabled = true;
  if (!app.getHostCapabilities()?.serverTools) {
    status.textContent = 'Waiting for a tool result. This host does not support refreshing from the view.';
    return;
  }
  status.textContent = 'Reading the installed manifest...';
  try { await show(await app.callServerTool({name:'read_manifest', arguments:{}})); }
  catch (error) { status.textContent = error.message; }
  finally { refresh.disabled = false; }
}

app.ontoolresult = result => show(result).catch(error => {status.textContent = error.message;});
refresh.addEventListener('click', reload);
app.connect().then(reload).catch(error => {status.textContent = `Could not connect to the host: ${error.message}`;});
